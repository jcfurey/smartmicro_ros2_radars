Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Metre grid
      Enabled: true
      Alpha: 0.25
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Color: 130; 145; 165
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: UMRR-96 housing
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /umrr96/robot_description
      Visual Enabled: true
      Collision Enabled: false
      TF Prefix: ''
    - Class: rviz_default_plugins/Axes
      Name: Sensor axes
      Enabled: true
      Reference Frame: <Fixed Frame>
      Length: 0.6
      Radius: 0.015
    - Class: rviz_default_plugins/PointCloud2
      Name: Static (Doppler inliers)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /umrr96_processing/doppler_inliers
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 235; 235; 235
      Style: Spheres
      Size (m): 0.08
      Alpha: 0.9
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Moving ghosts (rejected)
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /umrr96_processing/moving_ghosts
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 90; 140; 255
      Style: Spheres
      Size (m): 0.12
      Alpha: 0.6
      Decay Time: 0.5
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Moving targets (unconfirmed)
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /umrr96_processing/moving_targets
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 170; 150
      Style: Spheres
      Size (m): 0.2
      Alpha: 1
      Decay Time: 0.5
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Tracked targets
      Enabled: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /umrr96_processing/tracked_targets
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 60; 40
      Style: Spheres
      Size (m): 0.2
      Alpha: 1
      Decay Time: 0.5
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Nav2 obstacles
      Enabled: false
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /umrr96_processing/obstacles
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 80; 230; 120
      Style: Boxes
      Size (m): 0.25
      Alpha: 0.7
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracks (id, speed, velocity)
      Enabled: true
      Namespaces:
        label: true
        track: true
        velocity: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /umrr96_processing/track_markers
  Enabled: true
  Global Options:
    Background Color: 22; 27; 35
    Fixed Frame: umrr96
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 16
      Focal Point:
        X: 4
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 3.141592653589793
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
Window Geometry:
  Width: 1250
  Height: 850

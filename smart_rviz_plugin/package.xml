<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smart_rviz_plugin</name>
  <version>4.0.0</version>
  <description>RViz panels for smartmicro radars: recorder, command configurator, firmware download, status, fault reports and UMRR-96 configuration.</description>
  <maintainer email="shahrukh.raja@smartmicro.de">shahrukh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend condition="$ROS_DISTRO == 'humble' or $ROS_DISTRO == 'iron' or $ROS_DISTRO == 'jazzy' or $ROS_DISTRO == 'kilted'">qtbase5-dev</build_depend>
  <build_depend condition="$ROS_DISTRO == 'lyrical' or $ROS_DISTRO == 'rolling'">qt6-base-dev</build_depend>

  <depend>ament_index_cpp</depend>
  <depend>pluginlib</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rviz_common</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>umrr_ros2_msgs</depend>

  <!-- Host application for the panels. -->
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_cmake_flake8</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>ament_cmake_pep257</test_depend>
  <test_depend>ament_cmake_test</test_depend>
  <test_depend>ament_cmake_xmllint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
